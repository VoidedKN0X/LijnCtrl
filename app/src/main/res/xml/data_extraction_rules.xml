<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: the saved API key is encrypted with a Keystore key that
     only exists on this device (and with the app PIN when the lock is on), and the line cache can be fetched again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
