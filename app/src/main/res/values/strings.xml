    <!-- API key setup -->
    <string name="welcome_title">Welcome to LijnCtrl</string>
    <string name="change_api_key">Change API key</string>
    <string name="key_intro">LijnCtrl gets departures straight from De Lijn\'s open data. For that you need your own free API key, which takes a couple of minutes to get.</string>
    <string name="key_unreadable_intro">Your saved API key can\'t be read any more (this happens after the phone\'s secure storage is reset). Paste it again to carry on. Your saved stops are still here.</string>
    <string name="key_steps_title">How to get a key</string>
    <string name="key_step_1">Make a free account on De Lijn\'s developer portal, data.delijn.be.</string>
    <string name="key_step_2">Under Products, subscribe to the free Open Data product. One key covers both De Lijn APIs that LijnCtrl uses (departures and stop search).</string>
    <string name="key_step_3">Open your profile on the portal, copy the primary key, and paste it below.</string>
    <string name="open_de_lijn_portal">Open data.delijn.be</string>
    <string name="api_key">API key</string>
    <string name="show_key">Show key</string>
    <string name="hide_key">Hide key</string>
    <string name="key_stored_note">Checked with De Lijn, then stored encrypted on this phone</string>
    <string name="check_and_save">Check and save</string>
    <string name="checking_key">Checking with De Lijn…</string>
    <string name="key_privacy_note">Your key is only ever sent to api.delijn.be, over an encrypted connection. LijnCtrl has no servers of its own and collects nothing.</string>
    <string name="key_refused_by_both">De Lijn doesn\'t accept this key. Check that you copied the whole primary key and that your subscription to the Open Data product is active.</string>
    <string name="key_missing_core">This key works for stop search but not for departures (%1$s). Check that your subscription covers the Core API.</string>
    <string name="key_missing_search">This key works for departures but not for stop search (%1$s). Check that your subscription covers the Search API.</string>

