<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Stops near you: only asked when you open the Nearby tab and tap "Find stops near me". The location is read
         once from Android's own location service (no Google services) and sent to De Lijn's API to find stops. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Fingerprint unlock for the app lock: lets LijnCtrl ask Android for its own fingerprint prompt and check
         whether the phone has a strong fingerprint sensor. Without it the fingerprint option never shows. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Alerts: "your bus is almost here" and disruptions on your saved stops and lines. Asked for only when you
         turn one of them on. Bus alerts use Android's alarm clock (inexact unless Android allows exact alarms), with no
         extra permission and no service running while they wait. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hides other apps' floating windows while the lock screen, a PIN screen or a confirmation is showing
         (install-time, no prompt). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Android 16+: lets the trip guide's ongoing notification ask to be shown as a Live Update (status bar chip,
         top of the lock screen). Install-time, no prompt; you can turn Live Updates off for LijnCtrl in Android's
         notification settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Android 16 and newer: explicit intents from other apps (the launcher) must match one of the intent
         filters below; intents without an action are refused. LijnCtrl's own intents (shortcuts, notifications)
         aren't affected. -->
    <application
        android:name=".LijnCtrlApp"
        android:allowBackup="false"
        android:intentMatchingFlags="enforceIntentFilter"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LijnCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bus alerts: Android's alarm clock wakes this up a few times before a bus you set an alert for leaves, to
             refresh its live time and post the alert. Not exported: only LijnCtrl's own alarms reach it. -->
        <receiver
            android:name=".alerts.BusAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vknxworks.lijnctrl.alerts.CHECK" />
            </intent-filter>
        </receiver>

        <service
            android:name=".alerts.TripGuideService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- AndroidX adds two exported receivers for developer tooling (WorkManager diagnostics and the profile
             installer, both reached over adb). LijnCtrl doesn't need them, so they're removed. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- No downloadable emoji font: androidx.emoji2 would look one up from a font provider on start.
             Emoji use the phone's own font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
