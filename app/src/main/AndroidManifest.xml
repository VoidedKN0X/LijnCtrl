<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Stops near you: only asked when you open the Nearby tab and tap "Find stops near me". The location is read
         once from Android's own location service (no Google services) and sent to De Lijn's API to find stops. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Fingerprint unlock for the app lock: lets LijnCtrl ask Android for its own fingerprint prompt and check
         whether the phone has a strong fingerprint sensor. Without it the fingerprint option never shows. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Alerts: "your bus is almost here" and disruptions on your saved stops and lines. Asked for only when you
         turn one of them on. The bus alert runs as a visible notification while it watches your bus. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:name=".LijnCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LijnCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".alerts.BusAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".alerts.TripGuideService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- "Next departures" home-screen widget (Glance). Refreshed by WorkManager every 15 minutes and by its
             refresh button, never by the launcher (updatePeriodMillis is 0). -->
        <receiver
            android:name=".widget.DepartureWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/departure_widget_info" />
        </receiver>
        <!-- Picks the widget's stop. Only the launcher can start it with a widget it's adding (Android checks that
             the widget id belongs to the caller); it's behind the app lock like the app. -->
        <activity
            android:name=".widget.DepartureWidgetConfigActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LijnCtrl">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- No downloadable emoji font: androidx.emoji2 would look one up from a font provider on start.
             Emoji use the phone's own font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
